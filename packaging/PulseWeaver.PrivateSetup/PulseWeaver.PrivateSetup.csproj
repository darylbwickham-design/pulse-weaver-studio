<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">1.14.3</ReleaseVersion>
    <InstallerSuffix Condition="'$(InstallerSuffix)' == ''">RELEASE</InstallerSuffix>
    <PayloadArchive Condition="'$(PayloadArchive)' == ''">..\..\artifacts\channel-v$(ReleaseVersion)\payload.zip</PayloadArchive>
    <AssemblyName>PulseWeaver-Setup-$(ReleaseVersion)-$(InstallerSuffix)</AssemblyName>
    <Product Condition="'$(PreviewChannel)' != 'true' and '$(ShowcaseChannel)' != 'true'">Pulse Weaver Streaming Studio Setup</Product>
    <Product Condition="'$(PreviewChannel)' == 'true'">Pulse Weaver Motion Preview Setup</Product>
    <Product Condition="'$(ShowcaseChannel)' == 'true'">Pulse Weaver 2 Preview Setup</Product>
    <DefineConstants Condition="'$(PreviewChannel)' == 'true'">$(DefineConstants);PULSE_MOTION_PREVIEW</DefineConstants>
    <DefineConstants Condition="'$(AlphaChannel)' == 'true'">$(DefineConstants);PULSE_ALPHA</DefineConstants>
    <DefineConstants Condition="'$(UnstableChannel)' == 'true'">$(DefineConstants);PULSE_UNSTABLE</DefineConstants>
    <DefineConstants Condition="'$(ShowcaseChannel)' == 'true'">$(DefineConstants);PULSE_SHOWCASE_PREVIEW</DefineConstants>
    <AlphaRevision Condition="'$(AlphaRevision)' == ''">1</AlphaRevision>
    <Version>$(ReleaseVersion)</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>..\..\engine\obs-studio\frontend\cmake\windows\pulseweaver.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AlphaRevision" Value="$(AlphaRevision)" />
    <EmbeddedResource Include="$(PayloadArchive)"
                      LogicalName="PulseWeaver.Payload.zip"
                      Condition="'$(SkipPayloadEmbedding)' != 'true'" />
  </ItemGroup>
  <Target Name="ValidateShowcaseIdentity" BeforeTargets="CoreCompile" Condition="'$(ShowcaseChannel)' == 'true'">
    <Error Condition="'$(UnstableChannel)' != 'true' or '$(AlphaChannel)' == 'true' or '$(PreviewChannel)' == 'true'" Text="The isolated 2.0 showcase requires only the unstable channel." />
  </Target>
</Project>
