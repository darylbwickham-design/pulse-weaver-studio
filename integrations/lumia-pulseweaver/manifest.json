{
  "id": "pulseweavercontrol",
  "name": "PulseWeaver Stream Studio",
  "version": "1.5.0",
  "author": "Pulse Weaver",
  "description": "Connect Lumia Stream and LumiCon to Pulse Weaver streaming software. Switch Stages and Looks, control streaming, recording, sources, audio and media, and use the Pulse Weaver on-screen keypad to trigger your Lumia alerts.",
  "lumiaVersion": "^9.0.0",
  "category": "apps",
  "license": "MIT",
  "keywords": "Pulse Weaver,streaming,stages,OBS,multistream",
  "config": {
    "settings": [
      {
        "key": "port",
        "label": "Pulse Weaver port",
        "type": "number",
        "defaultValue": 18755,
        "validation": {
          "min": 1024,
          "max": 65535
        },
        "helperText": "Match the local API port shown in Pulse Weaver. The standard installation uses 18755. Existing custom ports are retained."
      },
      {
        "key": "apiToken",
        "label": "Connection token",
        "type": "password",
        "required": false,
        "helperText": "Normally detected automatically. Only enter this for a custom or portable Pulse Weaver installation."
      },
      {
        "key": "configPath",
        "label": "Custom Pulse Weaver configuration path",
        "type": "text",
        "required": false,
        "helperText": "Optional full path to pulse-weaver.ini when automatic detection cannot find it."
      }
    ],
    "actions": [
      {
        "type": "go_live",
        "label": "Start Show",
        "description": "Start the saved Twitch, Kick and YouTube destinations. Actual live state is confirmed.",
        "fields": []
      },
      {
        "type": "end_stream",
        "label": "End Show",
        "description": "Stop all streaming destinations; recording remains independent.",
        "fields": []
      },
      {
        "type": "start_platform",
        "label": "Start Platform",
        "description": "Start only this platform using its saved output mode. Configure it inside Pulse Weaver first.",
        "fields": [
          {
            "key": "platform",
            "label": "Platform",
            "type": "select",
            "required": true,
            "options": [
              {
                "label": "Twitch",
                "value": "twitch"
              },
              {
                "label": "Kick",
                "value": "kick"
              },
              {
                "label": "YouTube",
                "value": "youtube"
              }
            ],
            "defaultValue": "twitch"
          }
        ]
      },
      {
        "type": "stop_platform",
        "label": "Stop Platform",
        "description": "Stop only this platform; other destinations continue.",
        "fields": [
          {
            "key": "platform",
            "label": "Platform",
            "type": "select",
            "required": true,
            "options": [
              {
                "label": "Twitch",
                "value": "twitch"
              },
              {
                "label": "Kick",
                "value": "kick"
              },
              {
                "label": "YouTube",
                "value": "youtube"
              }
            ],
            "defaultValue": "twitch"
          }
        ]
      },
      {
        "type": "select_stage",
        "label": "Activate Stage",
        "description": "Run an existing Stage with its saved transition and routing.",
        "fields": [
          {
            "key": "stage",
            "label": "Stage",
            "type": "select",
            "required": true,
            "dynamicOptions": true,
            "options": []
          },
          {
            "key": "rememberPrevious",
            "label": "Remember previous stage / look",
            "type": "select",
            "options": [
              {
                "label": "Yes",
                "value": "true"
              },
              {
                "label": "No",
                "value": "false"
              }
            ],
            "defaultValue": "true",
            "required": false
          }
        ]
      },
      {
        "type": "next_stage",
        "label": "Next Stage",
        "description": "Activate the next existing Stage.",
        "fields": [
          {
            "key": "rememberPrevious",
            "label": "Remember previous stage / look",
            "type": "select",
            "options": [
              {
                "label": "Yes",
                "value": "true"
              },
              {
                "label": "No",
                "value": "false"
              }
            ],
            "defaultValue": "true",
            "required": false
          }
        ]
      },
      {
        "type": "previous_stage",
        "label": "Previous Stage",
        "description": "Activate the previous existing Stage.",
        "fields": [
          {
            "key": "rememberPrevious",
            "label": "Remember previous stage / look",
            "type": "select",
            "options": [
              {
                "label": "Yes",
                "value": "true"
              },
              {
                "label": "No",
                "value": "false"
              }
            ],
            "defaultValue": "true",
            "required": false
          }
        ]
      },
      {
        "type": "remember_presentation",
        "label": "Remember Current Stage / Look",
        "description": "Remember the current stage before several temporary actions. It stays remembered until Undo succeeds.",
        "fields": []
      },
      {
        "type": "run_motion",
        "label": "Run Stage Look / Motion Action",
        "description": "Run one action created in Pulse Weaver. Its Stage change, animation, hold and restore behaviour are handled as one operation.",
        "fields": [
          {
            "key": "action",
            "label": "Motion action",
            "type": "select",
            "required": true,
            "dynamicOptions": true,
            "options": []
          },
          {
            "key": "rememberPrevious",
            "label": "Remember previous stage / look",
            "type": "select",
            "options": [
              {
                "label": "Yes",
                "value": "true"
              },
              {
                "label": "No",
                "value": "false"
              }
            ],
            "defaultValue": "true",
            "required": false
          }
        ]
      },
      {
        "type": "restore_motion",
        "label": "Undo Previous Stage / Look",
        "description": "Undo your previous stage/look change from any current stage. Stops a running motion first. Existing Restore Last Motion bindings use this action.",
        "fields": []
      },
      {
        "type": "source_visibility",
        "label": "Source Visibility",
        "description": "Show or hide an existing scene item. Does not modify its layout or Stage definition.",
        "fields": [
          {
            "key": "target",
            "label": "Scene / Source",
            "type": "select",
            "required": true,
            "dynamicOptions": true,
            "options": []
          },
          {
            "key": "operation",
            "label": "Operation",
            "type": "select",
            "required": true,
            "options": [
              {
                "label": "Show",
                "value": "show"
              },
              {
                "label": "Hide",
                "value": "hide"
              },
              {
                "label": "Toggle visibility",
                "value": "toggle_visibility"
              }
            ],
            "defaultValue": "show"
          }
        ]
      },
      {
        "type": "source_mute",
        "label": "Source Mute",
        "description": "Control the existing source globally wherever its audio is used. Does not change platform audio routing.",
        "fields": [
          {
            "key": "source",
            "label": "Audio source",
            "type": "select",
            "required": true,
            "dynamicOptions": true,
            "options": []
          },
          {
            "key": "operation",
            "label": "Operation",
            "type": "select",
            "required": true,
            "options": [
              {
                "label": "Mute",
                "value": "mute"
              },
              {
                "label": "Unmute",
                "value": "unmute"
              },
              {
                "label": "Toggle mute",
                "value": "toggle_mute"
              }
            ],
            "defaultValue": "mute"
          }
        ]
      },
      {
        "type": "source_volume",
        "label": "Source Volume",
        "description": "Set the existing source volume globally, from 0 to 100 percent.",
        "fields": [
          {
            "key": "source",
            "label": "Audio source",
            "type": "select",
            "required": true,
            "dynamicOptions": true,
            "options": []
          },
          {
            "key": "volume",
            "label": "Volume (%)",
            "type": "number",
            "required": true,
            "defaultValue": 100,
            "validation": {
              "min": 0,
              "max": 100
            }
          }
        ]
      },
      {
        "type": "media_control",
        "label": "Media Playback",
        "description": "Operate an existing media source without replacing its file or URL.",
        "fields": [
          {
            "key": "source",
            "label": "Media source",
            "type": "select",
            "required": true,
            "dynamicOptions": true,
            "options": []
          },
          {
            "key": "operation",
            "label": "Operation",
            "type": "select",
            "required": true,
            "options": [
              {
                "label": "Play / Resume",
                "value": "play"
              },
              {
                "label": "Pause",
                "value": "pause"
              },
              {
                "label": "Restart",
                "value": "restart"
              },
              {
                "label": "Stop",
                "value": "stop_media"
              },
              {
                "label": "Next",
                "value": "next_media"
              },
              {
                "label": "Previous",
                "value": "previous_media"
              }
            ],
            "defaultValue": "play"
          }
        ]
      },
      {
        "type": "start_recording",
        "label": "Start Recording",
        "description": "Start the recording route already selected in Pulse Weaver.",
        "fields": []
      },
      {
        "type": "stop_recording",
        "label": "Stop Recording",
        "description": "Stop recording without ending the show.",
        "fields": []
      },
      {
        "type": "reconnect",
        "label": "Reconnect",
        "description": "Reconnect after opening Pulse Weaver or fixing connection settings.",
        "fields": []
      }
    ],
    "variables": [
