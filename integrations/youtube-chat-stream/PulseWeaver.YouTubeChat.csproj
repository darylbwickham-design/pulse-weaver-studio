<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PulseWeaver.YouTubeChat</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <Protobuf Include="stream_list.proto" GrpcServices="Client" />
    <Protobuf Include="error_details.proto" GrpcServices="None" />
  </ItemGroup>
</Project>
