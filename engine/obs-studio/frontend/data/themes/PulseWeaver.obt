@OBSThemeMeta {
    name: 'Pulse Weaver';
    id: 'com.pulseweaver.Theme';
    extends: 'com.obsproject.Yami';
    author: 'Pulse Weaver';
    dark: 'true';
}
@OBSThemeVars {
    /* Neutral production surfaces. Accent colour indicates purpose or state. */
    --grey1: #69798D;
    --grey2: #3B485A;
    --grey3: #2A3545;
    --grey4: #202B3A;
    --grey5: #192332;
    --grey6: #131C28;
    --grey7: #0D141E;
    --grey8: #080E16;
    --primary: #7057AE;
    --primary_light: #8A6ECA;
    --primary_lighter: #C4ACF0;
    --primary_dark: #58448B;
    --primary_darker: #30293F;
    --pw_accent: #C4ACF0;
    --pw_secondary: #9DBDC8;
    --pw_header: #111A26;
    --pw_selection: #30293F;
    --pw_rule: #283546;
    --text: #E7EEF8;
    --text_light: #FFFFFF;
    --text_muted: #9CAABD;
    --text_inactive: #F1F0F5;
    --text_disabled: #89909E;
    --warning: #DCAE64;
    --danger: #D45D70;
    --pw_live: #F18899;
    --pw_live_bg: #45232D;
    --pw_record: #E9BE7C;
    --pw_record_bg: #3F3221;
    --pw_success: #88D9B0;
    --bg_window: var(--grey7);
    --bg_base: var(--grey6);
    --bg_preview: var(--grey8);
    --input_bg: var(--grey8);
    --input_bg_hover: var(--grey6);
    --input_bg_focus: var(--grey8);
    --border_color: var(--pw_rule);
    --input_border: var(--grey2);
    --input_border_hover: var(--text_muted);
    --input_border_focus: var(--pw_accent);
    --button_bg: var(--grey5);
    --button_bg_hover: var(--grey3);
    --button_bg_down: var(--pw_selection);
    --button_border: var(--grey2);
    --button_border_hover: var(--text_muted);
    --button_border_focus: var(--pw_accent);
    --list_item_bg_selected: var(--pw_selection);
    --list_item_bg_hover: var(--grey5);
    --tab_bg: var(--bg_window);
    --tab_bg_down: var(--pw_selection);
    --tab_border_selected: var(--pw_accent);
    --scrollbar_handle: var(--grey2);
    --scrollbar_hover: var(--grey1);
    --scrollbar_bg: var(--bg_window);
    --scrollbar_size: 10px;
    --border_radius: 6px;
    --border_radius_large: 10px;
    --palette_alternateBase: var(--grey5);
    --palette_placeholderText: var(--text_muted);
    --palette_link: var(--pw_accent);
    --palette_linkVisited: var(--pw_accent);
    --palette_windowText_disabled: var(--text_disabled);
    --palette_buttonText_disabled: var(--text_disabled);
}

/* Static depth comes from edge highlights and gradients. No animation or
 * extra render loop is needed. Override Yami's 22px QPushButton ceiling:
 * each role below owns its actual content-box geometry. */
QWidget { font-family: "Segoe UI"; }
QMainWindow, QDialog, #centralwidget, #PulseWeaverPage, #PulseWeaverLightsHost, #PulseWeaverActionHost { background: var(--bg_window); color: var(--text); }
QLabel { background: transparent; }
QPushButton, QToolButton {
    border-image: none;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #35465A,stop:0.48 #28384B,stop:1 #1D2A3C);
    color: var(--text);
    border: 1px solid #41536A;
    border-top-color: #60728B;
    border-bottom: 3px solid #070E18;
    border-radius: 9px;
    margin: 0;
    padding: 5px 10px;
    max-height: 16777215px;
    font-weight: 600;
}
QPushButton { min-height: 20px; }
QPushButton:hover, QToolButton:hover, QToolButton:focus {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #455B73,stop:0.5 #34495F,stop:1 #26394E);
    border-top-color: #8A9DB4; border-left-color: #5E748F; border-right-color: #5E748F;
}
QPushButton:pressed, QPushButton:pressed:hover, QPushButton:pressed:focus,
QToolButton:pressed, QToolButton:pressed:hover, QToolButton:pressed:focus,
QPushButton:checked, QPushButton:checked:hover, QPushButton:checked:focus,
QToolButton:checked, QToolButton:checked:hover, QToolButton:checked:focus {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #111B29,stop:0.35 #1B2A3D,stop:1 #2C4057);
    border-top-color: #080F19; border-bottom-color: #4A5F78; color: var(--text_light);
}
QPushButton:focus, QToolButton:focus { border-left-color: var(--pw_accent); border-right-color: var(--pw_accent); border-top-color: var(--pw_accent); }
QPushButton:disabled, QToolButton:disabled { background: var(--bg_base); color: var(--text_disabled); border-color: #2A3544; border-bottom-color: #0A111B; }
QPushButton#Primary {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 var(--primary),stop:1 var(--primary_dark));
    border-top-color: var(--primary_lighter); color: var(--text_light);
}
QToolButton { padding: 4px 6px; }
QPushButton::menu-indicator { subcontrol-position: right center; right: 5px; }
QToolButton::menu-indicator { subcontrol-position: right bottom; }
QGroupBox { background: var(--bg_base); border: 1px solid var(--pw_rule); border-top-color: #3C4B60; border-radius: 10px; margin-top: 14px; padding: 10px; }
QGroupBox::title { color: var(--text_muted); subcontrol-origin: margin; left: 10px; padding: 0 5px; font-weight: 600; }
QGroupBox#ConnectionCard { padding: 14px; }
QGroupBox#ConnectionCard::title { color: var(--pw_accent); }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0A111C,stop:1 #182639);
    color: var(--text); border: 1px solid #33465D; border-top-color: #080E17; border-bottom-color: #4B6079;
    border-radius: 8px; min-height: 20px; padding: 4px 8px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: var(--pw_accent); }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { color: var(--text_disabled); background: var(--bg_window); border-color: var(--pw_rule); }
QComboBox::drop-down { border: none; width: 24px; }
QHeaderView::section { background: var(--bg_window); color: var(--text_muted); border: none; border-bottom: 1px solid var(--pw_rule); padding: 7px; font-weight: 600; }
QTableView, QTreeView, QListView, QTextEdit, QPlainTextEdit { background: var(--bg_base); border: 1px solid var(--pw_rule); border-radius: 8px; }
QTreeView::item, QListView::item { padding: 3px; }
QTreeView::item:selected, QListView::item:selected { background: var(--pw_selection); color: var(--text); }
QMenu { background: var(--bg_base); color: var(--text); border: 1px solid #4B5E76; border-top-color: #6F829A; border-radius: 8px; padding: 5px; }
QMenu::item { padding-top: 6px; padding-bottom: 6px; border-radius: 5px; }
QMenu::item:selected { background: var(--pw_selection); }
QMenu::separator { height: 1px; background: var(--pw_rule); margin: 5px 8px; }
QToolTip { background: var(--grey5); color: var(--text); border: 1px solid var(--grey2); border-radius: 5px; padding: 7px; }
QTabWidget::pane { border: 1px solid #3D5067; border-top-color: #5A6D84; border-radius: 9px; background: var(--bg_base); }
QTabBar::tab { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #304258,stop:1 #1B293B); color: var(--text_muted); border: 1px solid #3E526B; border-top-color: #596E89; border-bottom: 3px solid #080F19; border-top-left-radius: 8px; border-top-right-radius: 8px; padding: 7px 12px; margin-right: 3px; font-weight: 600; }
QTabBar::tab:selected { background: var(--pw_selection); color: var(--text); border-top-color: var(--pw_accent); border-bottom-color: var(--pw_selection); }
QTabBar::tab:hover { color: var(--text); background: var(--grey3); }
QTabBar::tab:disabled { color: var(--text_disabled); }
QDockWidget::title { background: var(--bg_base); color: var(--text_muted); border: none; border-bottom: 1px solid var(--pw_rule); padding: 8px 10px; font-weight: 600; }
QSplitter::handle { background: var(--bg_window); }
QSplitter::handle:hover { background: var(--primary_dark); }
QStatusBar { background: var(--bg_window); color: var(--text_muted); }

/* Four permanent workspace keys. Utilities remain subordinate and compact. */
#PulseWeaverHeader { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #1C2B3D,stop:1 #0F1927); border: none; border-bottom: 1px solid #3C5068; border-radius: 0; }
#PulseWeaverBrand { color: var(--text); font-size: 16px; font-weight: 700; padding: 0; }
#PulseWeaverPreviewVersion { color: #E7BB6B; background: transparent; border: none; padding: 0; font-size: 9px; font-weight: 600; }
QPushButton#PulseWeaverHome, QPushButton#PulseWeaverNav {
    height: 40px; min-height: 40px; max-height: 40px; padding: 0; font-size: 14px; font-weight: 600; border-radius: 10px;
}
QPushButton#PulseWeaverHome[pulseWorkspaceActive="true"], QPushButton#PulseWeaverNav[pulseWorkspaceActive="true"] {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 var(--primary),stop:0.48 var(--primary_dark),stop:1 var(--primary_darker));
    border-color: var(--primary_light); border-top-color: var(--primary_lighter); border-bottom-color: #10101B; color: var(--text_light);
}
QPushButton#PulseWeaverHome:pressed, QPushButton#PulseWeaverNav:pressed { background: var(--primary_dark); border-top-color: #080F19; border-bottom-color: var(--primary_light); }
QPushButton#PulseWeaverUtility, QPushButton#PulseWeaverCommandButton { height: 30px; min-height: 30px; max-height: 30px; padding: 0; font-size: 11px; border-radius: 8px; }
QPushButton#PulseWeaverUtility[pulseWorkspaceActive="true"] { background: var(--pw_selection); border-top-color: var(--pw_accent); }

/* The production toolbar is a shallow console, not another page heading. */
QFrame#PulseWeaverProductionControls { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #202F42,stop:1 #142033); border: 1px solid #33485F; border-top-color: #51667F; border-bottom-color: #070E18; border-radius: 10px; }
QFrame#PulseWeaverModeSwitch { background: #0C1522; border: 1px solid #40536D; border-top-color: #070D16; border-radius: 10px; }
QPushButton#PulseWeaverShowMode, QPushButton#PulseWeaverControlMode { height: 30px; min-height: 30px; max-height: 30px; padding: 0; font-size: 11px; border-radius: 8px; }
QPushButton#PulseWeaverShowMode:checked, QPushButton#PulseWeaverControlMode:checked { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 var(--primary),stop:1 var(--primary_dark)); color: var(--text_light); border-top-color: var(--primary_lighter); border-bottom-color: #0B111C; }
QPushButton#PulseWeaverStageChoice { height: 30px; min-height: 30px; max-height: 30px; padding: 0 10px; font-size: 13px; font-weight: 600; text-align: left; }
QComboBox#PulseWeaverGameWindow { min-height: 24px; max-height: 24px; padding: 4px 8px; }
QToolButton#PulseWeaverGameSettings, QToolButton#PulseWeaverConnections, QToolButton#PulseWeaverLumiaGuide { padding: 0; min-height: 0; min-width: 0; border-radius: 8px; }
QPushButton#PulseWeaverStatsDetails { height: 24px; min-height: 24px; max-height: 24px; padding: 2px 6px; font-size: 11px; }
QFrame#PulseWeaverShowHeading { background: transparent; border: none; }
#PulseWeaverStatus { color: var(--text_muted); background: transparent; border: none; padding: 3px 0; font-size: 10px; }

/* Programme and chat share one restrained recessed surface language. */
QFrame#PulseWeaverCard, QFrame#PulseWeaverSetupCard { background: var(--bg_base); border: 1px solid #32465C; border-top-color: #50637A; border-bottom-color: #070E18; border-radius: 10px; }
QFrame#PulseWeaverStage { background: var(--bg_preview); border: 1px solid #364B62; border-top-color: #5A708B; border-bottom-color: #070C15; border-radius: 10px; }
QFrame#PulseWeaverStage[pulseWeaverPreviewProvider="twitch"] { border-top-color: #9146FF; }
QFrame#PulseWeaverStage[pulseWeaverPreviewProvider="youtube"] { border-top-color: #FF0033; }
QFrame#PulseWeaverStage[pulseWeaverPreviewProvider="kick"] { border-top-color: #53FC18; }
QFrame#PulseWeaverStage[pulseWeaverPreviewProvider="recording"] { border-top-color: #F5AA29; }
#PulseWeaverHeading { font-size: 18px; font-weight: 600; color: var(--text); }
#PulseWeaverCardTitle { font-size: 14px; font-weight: 600; color: var(--text); }
QToolButton#PulseWeaverCardTitle { min-height: 24px; padding: 0 7px; font-size: 14px; }
QToolButton#PulseWeaverChatPanelOptions { padding: 0; min-width: 0; min-height: 0; }
QToolButton#PulseWeaverChatPanelOptions::menu-indicator { image: none; }
#PulseWeaverKicker, #Kicker { font-size: 11px; font-weight: 600; color: var(--text_muted); }
#PulseWeaverMuted, #Muted, #PulseWeaverChatStatus, #PulseWeaverDestinationStatus { color: var(--text_muted); font-size: var(--font_base); }
#PulseWeaverBadge { background: var(--grey5); color: var(--text_muted); border: none; border-radius: 5px; padding: 2px 6px; font-size: var(--font_xsmall); font-weight: 600; }
#PulseWeaverWarning { color: var(--pw_record); background: var(--pw_record_bg); border: 1px solid var(--warning); border-radius: 6px; padding: 8px; }
QListWidget#PulseWeaverActivity, QListWidget#PulseWeaverChatFeed { background: var(--bg_base); color: var(--text); border: none; padding: 2px; }
QToolButton#PulseWeaverChatFilter { min-height: 20px; padding: 3px 7px; font-size: var(--font_small); }
QToolButton#PulseWeaverChatFilter:checked { background: var(--pw_selection); border-top-color: var(--pw_accent); color: var(--text); }
QPushButton#PulseWeaverChatNewMessages { background: var(--pw_selection); border-top-color: var(--primary_light); color: var(--text); padding: 5px 8px; }
#PulseWeaverCompactMixer, #PulseWeaverNativeMixerStrip { background: var(--bg_base); border: none; }
#PulseWeaverMixerStrip { background: var(--bg_base); border: none; border-right: 1px solid var(--pw_rule); }
QFrame#PulseWeaverStreamStats { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #1A293B,stop:1 #111D2D); border: 1px solid #30445B; border-top-color: #435B74; border-radius: 8px; }
QFrame#PulseWeaverStreamStats[pulseWeaverStatsAccent="#9146FF"] { border-left-color: #9146FF; }
QFrame#PulseWeaverStreamStats[pulseWeaverStatsAccent="#FF3B30"] { border-left-color: #FF0033; }
QFrame#PulseWeaverStreamStats[pulseWeaverStatsAccent="#53FC18"] { border-left-color: #53FC18; }
#PulseWeaverStatsTitle { color: var(--text); font-size: var(--font_small); font-weight: 600; }
#PulseWeaverStatsLabel { color: var(--text_muted); font-size: var(--font_xsmall); font-weight: 500; }
#PulseWeaverStatsValue { color: var(--text); font-family: "Consolas"; font-size: 13px; font-weight: 600; }
#previewContainer { background: var(--bg_preview); border: none; }
OBSQTDisplay { qproperty-displayBackgroundColor: #0A0B0F; }
#PulseWeaverWorkSurface, #PulseWeaverWorkSurface > QWidget { background: var(--bg_window); border: none; }
#PulseWeaverTransport { background: var(--bg_window); border: none; }

/* Raised transport caps echo the approved coloured route thumbs. */
QPushButton#PulseWeaverLive, QPushButton#Live, #streamButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ADF0F6,stop:0.5 #70D3E6,stop:1 #45AFC9);
    border-color: #3A8FA9; border-top-color: #D8FCFF; border-bottom-color: #16475A; color: #071823; padding: 7px 16px; font-weight: 700;
}
QPushButton#PulseWeaverLive:hover, QPushButton#Live:hover, #streamButton:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #D4FCFF,stop:1 #71D8EB); }
QPushButton#PulseWeaverRecord, #recordButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFD991,stop:0.5 #F5AA29,stop:1 #D78A16);
    border-color: #B06F13; border-top-color: #FFEBC5; border-bottom-color: #55340B; color: #231506; padding: 7px 14px; font-weight: 700;
}
QPushButton#PulseWeaverRecord:hover, #recordButton:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFEAC4,stop:1 #F6BD56); }
QPushButton#PulseWeaverLive:pressed, QPushButton#PulseWeaverRecord:pressed { border-top-color: #101822; border-bottom-color: #C9DCE8; }
QPushButton#PulseWeaverLive[pulseActive="true"], QPushButton#PulseWeaverRecord[pulseActive="true"] { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #B7485F,stop:1 #79283B); border-top-color: #EB8396; border-bottom-color: #3D1220; color: #FFFFFF; }
QPushButton#PulseWeaverLive:disabled, QPushButton#PulseWeaverRecord:disabled { background: var(--bg_base); border-color: #2A3544; color: var(--text_disabled); }
QPushButton#PulseWeaverLive:focus, QPushButton#PulseWeaverRecord:focus { border-left-color: #FFFFFF; border-right-color: #FFFFFF; border-top-color: #FFFFFF; }

/* Click-through cards retain their own flexible height; no inherited cap. */
QDialog#PulseWeaverCommandPalette { background: var(--bg_window); }
QLineEdit#PulseWeaverCommandSearch { min-height: 26px; padding: 8px 12px; font-size: 15px; }
QPushButton#PulseWeaverChoiceCard {
    min-height: 0; max-height: 16777215px; padding: 0; border-radius: 11px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #2D4056,stop:0.55 #223247,stop:1 #172538);
}
/* Height is the CSS content box: 90 + 1px top + 3px bottom = 94px.
 * Explicit role dimensions also replace Yami's inherited height:22px. */
QPushButton#PulseWeaverChoiceCard { height: 90px; min-height: 90px; max-height: 90px; }
QPushButton#PulseWeaverChoiceCard[pulseSetupCategoryCard="true"] { height: 106px; min-height: 106px; max-height: 106px; }
QPushButton#PulseWeaverChoiceCard:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #415A75,stop:1 #253B53); border-top-color: #90AAC5; }
QPushButton#PulseWeaverChoiceCard:pressed { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #111E30,stop:1 var(--pw_selection)); border-top-color: #08111C; border-bottom-color: var(--primary_light); }
QPushButton#PulseWeaverSetupBack { padding: 5px 12px; }
QToolButton#PulseWeaverMotionPolicyChoice { height: -1px; min-height: 54px; max-height: 16777215px; padding: 5px 10px; text-align: left; }
QToolButton#PulseWeaverMotionPlacement { height: -1px; min-height: 24px; max-height: 16777215px; padding: 4px 8px; }
QPushButton#PulseWeaverMotionStageChoice { height: 24px; min-height: 24px; max-height: 16777215px; padding: 4px 9px; }
QToolButton#PulseWeaverMotionSourceChoice { height: -1px; min-height: 24px; max-height: 16777215px; padding: 4px 8px; }
QToolButton#PulseWeaverMotionSourceChoice[pulseSelected="true"] { background: var(--pw_selection); border-top-color: var(--pw_accent); color: var(--text_light); }
QToolButton#PulseWeaverMotionVisibility { height: -1px; min-height: 22px; max-height: 16777215px; padding: 3px 7px; }

/* Show setup owns a calm blue/cyan accent without changing the production
 * console. All shell rules are scoped to the wizard or an explicit setup dialog. */
QWizard#PulseWeaverSetupWizard, QDialog[pulseSetupDialog="true"], QDialog#PulseWeaverSetupDialog {
    background: #0D1724; color: #EAF2FC; font-size: 14px;
}
#PulseWeaverSetupWizard QWizardPage { background: transparent; border: none; }
#PulseWeaverSetupWizard QLabel, QDialog[pulseSetupDialog="true"] QLabel, QDialog#PulseWeaverSetupDialog QLabel { background: transparent; }
#PulseWeaverSetupWizard QLabel#PulseSetupEyebrow,
QDialog[pulseSetupDialog="true"] QLabel#PulseSetupEyebrow,
QDialog#PulseWeaverSetupDialog QLabel#PulseSetupEyebrow { color: #72DAE8; font-size: 11px; font-weight: 700; padding: 0; }
#PulseWeaverSetupWizard QLabel#PulseSetupTitle,
QDialog[pulseSetupDialog="true"] QLabel#PulseSetupTitle,
QDialog#PulseWeaverSetupDialog QLabel#PulseSetupTitle { color: #F2F7FF; font-size: 23px; font-weight: 700; padding: 0; }
#PulseWeaverSetupWizard QLabel#PulseSetupSubtitle,
QDialog[pulseSetupDialog="true"] QLabel#PulseSetupSubtitle,
QDialog#PulseWeaverSetupDialog QLabel#PulseSetupSubtitle { color: #B4C5D9; font-size: 14px; font-weight: 400; padding: 0; }
#PulseWeaverSetupWizard QLabel#PulseSetupMuted,
QDialog[pulseSetupDialog="true"] QLabel#PulseSetupMuted,
QDialog#PulseWeaverSetupDialog QLabel#PulseSetupMuted { color: #ADBED3; font-size: 13px; font-weight: 400; }
#PulseWeaverSetupWizard QLabel#PulseSetupSectionTitle,
QDialog[pulseSetupDialog="true"] QLabel#PulseSetupSectionTitle,
QDialog#PulseWeaverSetupDialog QLabel#PulseSetupSectionTitle { color: #EAF2FC; font-size: 15px; font-weight: 600; }
#PulseWeaverSetupWizard QWidget#PulseSetupSurface,
QDialog[pulseSetupDialog="true"] QWidget#PulseSetupSurface,
QDialog#PulseWeaverSetupDialog QWidget#PulseSetupSurface {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #1C2C40,stop:1 #142234);
    border: 1px solid #344B65; border-top-color: #506982; border-radius: 12px;
}
#PulseWeaverSetupWizard QWidget#PulseSetupNotice,
QDialog[pulseSetupDialog="true"] QWidget#PulseSetupNotice,
QDialog#PulseWeaverSetupDialog QWidget#PulseSetupNotice {
    background: #142C3A; color: #D5EDF6; border: 1px solid #346079; border-radius: 10px; padding: 10px;
}
#PulseWeaverSetupWizard QLabel[setupPhaseState="upcoming"] { color: #9CAFC7; background: #152235; border: 1px solid #2E435C; border-radius: 8px; padding: 7px 12px; }
#PulseWeaverSetupWizard QLabel[setupPhaseState="complete"] { color: #B7E5EF; background: #173542; border: 1px solid #376476; border-radius: 8px; padding: 7px 12px; }
#PulseWeaverSetupWizard QLabel[setupPhaseState="current"] { color: #F0FCFF; background: #21465F; border: 1px solid #6DD4E4; border-bottom: 3px solid #0A1A29; border-radius: 8px; padding: 7px 12px; font-weight: 700; }
#PulseWeaverSetupWizard QGroupBox,
QDialog[pulseSetupDialog="true"] QGroupBox,
QDialog#PulseWeaverSetupDialog QGroupBox { background: #142234; border: 1px solid #344B65; border-top-color: #506982; border-radius: 12px; margin-top: 15px; padding: 12px; }
#PulseWeaverSetupWizard QGroupBox::title,
QDialog[pulseSetupDialog="true"] QGroupBox::title,
QDialog#PulseWeaverSetupDialog QGroupBox::title { color: #BDDAE9; font-weight: 600; }
#PulseWeaverSetupWizard QScrollArea,
QDialog[pulseSetupDialog="true"] QScrollArea,
QDialog#PulseWeaverSetupDialog QScrollArea { background: transparent; border: none; }
#PulseWeaverSetupWizard QLineEdit, #PulseWeaverSetupWizard QComboBox, #PulseWeaverSetupWizard QSpinBox,
QDialog[pulseSetupDialog="true"] QLineEdit, QDialog[pulseSetupDialog="true"] QComboBox, QDialog[pulseSetupDialog="true"] QSpinBox,
QDialog#PulseWeaverSetupDialog QLineEdit, QDialog#PulseWeaverSetupDialog QComboBox, QDialog#PulseWeaverSetupDialog QSpinBox {
    min-height: 24px; padding: 7px 10px; background: #0B1624; border: 1px solid #405874; border-top-color: #07101B; border-bottom-color: #5C728A; border-radius: 9px; color: #ECF4FF;
}
#PulseWeaverSetupWizard QLineEdit:focus, #PulseWeaverSetupWizard QComboBox:focus, #PulseWeaverSetupWizard QSpinBox:focus,
QDialog[pulseSetupDialog="true"] QLineEdit:focus, QDialog[pulseSetupDialog="true"] QComboBox:focus, QDialog[pulseSetupDialog="true"] QSpinBox:focus,
QDialog#PulseWeaverSetupDialog QLineEdit:focus, QDialog#PulseWeaverSetupDialog QComboBox:focus, QDialog#PulseWeaverSetupDialog QSpinBox:focus { border-color: #73DCEB; }
#PulseWeaverSetupWizard QPushButton, QDialog[pulseSetupDialog="true"] QPushButton, QDialog#PulseWeaverSetupDialog QPushButton {
    height: -1px; min-height: 26px; max-height: 16777215px; margin: 0; padding: 7px 14px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #354B64,stop:0.5 #293D56,stop:1 #1B2D43);
    border: 1px solid #49627F; border-top-color: #7088A3; border-bottom: 3px solid #07111D; border-radius: 10px; color: #EAF2FC; font-weight: 600;
}
#PulseWeaverSetupWizard QPushButton:hover, QDialog[pulseSetupDialog="true"] QPushButton:hover, QDialog#PulseWeaverSetupDialog QPushButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #426581,stop:1 #27445F); border-top-color: #91C3D7;
}
#PulseWeaverSetupWizard QPushButton:pressed, QDialog[pulseSetupDialog="true"] QPushButton:pressed, QDialog#PulseWeaverSetupDialog QPushButton:pressed {
    background: #182B41; border-top-color: #07111D; border-bottom-color: #6A8AA4;
}
#PulseWeaverSetupWizard QPushButton:focus, QDialog[pulseSetupDialog="true"] QPushButton:focus, QDialog#PulseWeaverSetupDialog QPushButton:focus { border-left-color: #85E5F0; border-right-color: #85E5F0; border-top-color: #85E5F0; }
#PulseWeaverSetupWizard QPushButton[setupPrimary="true"], QDialog[pulseSetupDialog="true"] QPushButton[setupPrimary="true"], QDialog#PulseWeaverSetupDialog QPushButton[setupPrimary="true"] {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #59C5DD,stop:0.5 #319DBD,stop:1 #247A9D);
    color: #061D2A; border-color: #60CCDF; border-top-color: #B5F5FC; border-bottom: 3px solid #0B3A52;
}
#PulseWeaverSetupWizard QPushButton[setupPrimary="true"]:hover, QDialog[pulseSetupDialog="true"] QPushButton[setupPrimary="true"]:hover, QDialog#PulseWeaverSetupDialog QPushButton[setupPrimary="true"]:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #8CE4EF,stop:1 #42B6CF); }
#PulseWeaverSetupWizard QPushButton[setupPrimary="true"]:pressed, QDialog[pulseSetupDialog="true"] QPushButton[setupPrimary="true"]:pressed, QDialog#PulseWeaverSetupDialog QPushButton[setupPrimary="true"]:pressed { background: #2A8FAB; border-top-color: #0B3A52; border-bottom-color: #91DFEB; }
#PulseWeaverSetupWizard QPushButton:disabled, QDialog[pulseSetupDialog="true"] QPushButton:disabled, QDialog#PulseWeaverSetupDialog QPushButton:disabled { background: #172435; color: #8195AF; border-color: #2C4058; border-bottom-color: #0B1522; }

/* Responsive choices paint title, detail and selection inside their own surface.
 * Clear inherited button dimensions: geometry is owned by heightForWidth. */
QPushButton#PulseWeaverSetupChoiceCard {
    height: -1px; min-height: 0; max-height: 16777215px; min-width: 0; margin: 0; padding: 0; font-size: 15px; font-weight: 600;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #293E55,stop:0.55 #203248,stop:1 #17273B);
    color: #EDF4FF; border: 2px solid #3C526D; border-top-color: #627C97; border-bottom: 3px solid #081320; border-radius: 12px;
}
QPushButton#PulseWeaverSetupChoiceCard:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #34556F,stop:1 #213D56); border-color: #668EA8; border-top-color: #9ACBDD; }
QPushButton#PulseWeaverSetupChoiceCard:checked { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #24516A,stop:0.55 #1C3D56,stop:1 #183149); border-color: #60C8D9; border-top-color: #9CEAF2; color: #F2FCFF; }
QPushButton#PulseWeaverSetupChoiceCard:checked:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #2D617A,stop:1 #21465E); border-color: #89E2ED; }
QPushButton#PulseWeaverSetupChoiceCard:pressed { background: #162D43; border-top-color: #081320; border-bottom-color: #7898AF; }
QPushButton#PulseWeaverSetupChoiceCard:focus { border-color: #A5F1F7; border-top-color: #E0FCFF; }
QPushButton#PulseWeaverSetupChoiceCard:disabled { background: #152235; color: #8296AD; border-color: #2D4057; border-top-color: #3B4D64; border-bottom-color: #091420; }
QWidget#PulseWeaverSetupChoiceGrid { background: transparent; border: none; }
QLabel#PulseSetupChoiceEmpty { color: #BDCADB; background: #16273B; border: 1px solid #3B536E; border-radius: 10px; padding: 16px; font-size: 14px; }
#PulseWeaverSetupWizard QLabel#PulseSetupCurrentIssue, #PulseWeaverSetupWizard QLabel#PulseSetupError,
QDialog[pulseSetupDialog="true"] QLabel#PulseSetupCurrentIssue, QDialog[pulseSetupDialog="true"] QLabel#PulseSetupError,
QDialog#PulseWeaverSetupDialog QLabel#PulseSetupCurrentIssue, QDialog#PulseWeaverSetupDialog QLabel#PulseSetupError { color: #FFE6BA; background: #342D23; border: 1px solid #8A7147; border-radius: 9px; padding: 10px 12px; font-size: 14px; }
QLineEdit#PulseSetupChoiceSearch { min-height: 26px; padding: 8px 12px; font-size: 14px; }
