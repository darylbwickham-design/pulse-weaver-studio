@OBSThemeMeta {
    name: 'Electric';
    id: 'com.pulseweaver.Electric';
    extends: 'com.pulseweaver.Theme';
    author: 'Pulse Weaver';
    dark: 'true';
}
@OBSThemeVars {
    --primary: #267F91;
    --primary_light: #5DBBD0;
    --primary_lighter: #A7E5EF;
    --primary_dark: #205A69;
    --pw_accent: #80D7E7;
    --pw_selection: #18333D;
}

/* The 2.0 workspaces share raised controls and recessed production surfaces.
 * Appearance changes selected caps and focus cues without changing geometry. */