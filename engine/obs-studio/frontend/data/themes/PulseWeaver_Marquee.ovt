@OBSThemeMeta {
    name: 'Marquee';
    id: 'com.pulseweaver.Marquee';
    extends: 'com.pulseweaver.Theme';
    author: 'Pulse Weaver';
    dark: 'true';
}
@OBSThemeVars {
    --primary: #92704B;
    --primary_light: #C39B69;
    --primary_lighter: #E8CC9C;
    --primary_dark: #624B35;
    --pw_accent: #DFBE8D;
    --pw_selection: #393024;
}

/* The 2.0 workspaces share raised controls and recessed production surfaces.
 * Appearance changes selected caps and focus cues without changing geometry. */