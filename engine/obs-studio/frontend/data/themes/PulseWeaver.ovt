@OBSThemeMeta {
    name: 'Backstage';
    id: 'com.pulseweaver.Studio';
    extends: 'com.pulseweaver.Theme';
    author: 'Pulse Weaver';
    dark: 'true';
}

/* Original backstage vector control surrounds and stage artwork. */
QPushButton#PulseWeaverControl, QPushButton#PulseWeaverUtility, QPushButton#PulseWeaverOverlayButton, QPushButton#PulseWeaverDockLockToggle { padding: 1px 6px; }
QPushButton#PulseWeaverControl, QPushButton#PulseWeaverUtility, QPushButton#PulseWeaverOverlayButton, QPushButton#PulseWeaverDockLockToggle { border-image: url(theme:PulseWeaver/backstage/button.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverControl:hover, QPushButton#PulseWeaverUtility:hover, QPushButton#PulseWeaverOverlayButton:hover, QPushButton#PulseWeaverDockLockToggle:hover { border-image: url(theme:PulseWeaver/backstage/hover.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverControl:pressed, QPushButton#PulseWeaverUtility:pressed, QPushButton#PulseWeaverOverlayButton:pressed, QPushButton#PulseWeaverDockLockToggle:pressed { border-image: url(theme:PulseWeaver/backstage/pressed.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverControl:checked, QPushButton#PulseWeaverUtility:checked, QPushButton#PulseWeaverOverlayButton:checked, QPushButton#PulseWeaverDockLockToggle:checked { border-image: url(theme:PulseWeaver/backstage/pressed.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverHome, QPushButton#PulseWeaverNav { padding: 6px 10px; border-radius: 10px; font-family: "Segoe UI"; font-size: 13px; font-weight: 600; color: var(--text); }
QPushButton#PulseWeaverHome, QPushButton#PulseWeaverNav { border-image: url(theme:PulseWeaver/backstage/button.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverHome[pulseWorkspaceActive="true"], QPushButton#PulseWeaverNav[pulseWorkspaceActive="true"] { border-image: url(theme:PulseWeaver/backstage/hover.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverNav[workspace="camera"] { border-image: url(theme:PulseWeaver/backstage/camera.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverNav[workspace="lights"] { border-image: url(theme:PulseWeaver/backstage/lights.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverNav[workspace="action"] { border-image: url(theme:PulseWeaver/backstage/action.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverHome[pulseWorkspaceActive="true"], QPushButton#PulseWeaverNav[pulseWorkspaceActive="true"] { color: var(--text_light); font-weight: 600; }
QPushButton#PulseWeaverHome:focus, QPushButton#PulseWeaverNav:focus { text-decoration: underline; }
QFrame#PulseWeaverBanner { background: var(--pw_header); background-image: url(theme:PulseWeaver/backstage/banner.svg); background-repeat: no-repeat; background-position: center center; border: none; border-radius: 10px; }
QFrame#PulseWeaverStage, QFrame#PulseWeaverStreamStats, QFrame#PulseWeaverCard { border-image: url(theme:PulseWeaver/backstage/panel.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QFrame#PulseWeaverStage[pulseWeaverPreviewProvider="twitch"] { border-image: url(theme:PulseWeaver/backstage/panel-twitch.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QFrame#PulseWeaverStreamStats[pulseWeaverStatsAccent="#9146FF"] { border-image: url(theme:PulseWeaver/backstage/panel-twitch.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QFrame#PulseWeaverStage[pulseWeaverPreviewProvider="youtube"] { border-image: url(theme:PulseWeaver/backstage/panel-youtube.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QFrame#PulseWeaverStreamStats[pulseWeaverStatsAccent="#FF3B30"] { border-image: url(theme:PulseWeaver/backstage/panel-youtube.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QFrame#PulseWeaverStage[pulseWeaverPreviewProvider="kick"] { border-image: url(theme:PulseWeaver/backstage/panel-kick.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QFrame#PulseWeaverStreamStats[pulseWeaverStatsAccent="#53FC18"] { border-image: url(theme:PulseWeaver/backstage/panel-kick.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QFrame#PulseWeaverStage[pulseWeaverPreviewProvider="recording"] { border-image: url(theme:PulseWeaver/backstage/panel-recording.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QFrame#PulseWeaverStreamStats[pulseWeaverStatsAccent="#FFAD38"] { border-image: url(theme:PulseWeaver/backstage/panel-recording.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverLive { border-image: url(theme:PulseWeaver/backstage/live.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverRecord { border-image: url(theme:PulseWeaver/backstage/record.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverLive[pulseActive="true"], QPushButton#PulseWeaverRecord[pulseActive="true"] { border-image: url(theme:PulseWeaver/backstage/active.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverControl:disabled, QPushButton#PulseWeaverUtility:disabled, QPushButton#PulseWeaverOverlayButton:disabled, QPushButton#PulseWeaverDockLockToggle:disabled, QPushButton#PulseWeaverLive:disabled, QPushButton#PulseWeaverRecord:disabled { border-image: none; border: 1px solid var(--pw_rule); background: var(--bg_base); color: var(--text_disabled); }
QPushButton#PulseWeaverControl:focus, QPushButton#PulseWeaverUtility:focus, QPushButton#PulseWeaverOverlayButton:focus, QPushButton#PulseWeaverDockLockToggle:focus, QPushButton#PulseWeaverLive:focus, QPushButton#PulseWeaverRecord:focus { border-image: url(theme:PulseWeaver/backstage/focus.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QPushButton#PulseWeaverLive[pulseActive="true"]:focus, QPushButton#PulseWeaverRecord[pulseActive="true"]:focus { border-image: url(theme:PulseWeaver/backstage/focus-active.svg) 14 14 14 14 stretch stretch; border-width: 7px; border-style: solid; border-color: transparent; border-radius: 0; background-color: transparent; }
QComboBox, QLineEdit, QSpinBox { border-radius: 6px; }
QDockWidget::title { border-left: 3px solid var(--pw_secondary); }
