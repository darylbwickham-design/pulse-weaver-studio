@OBSThemeMeta {
    name: 'Backstage';
    id: 'com.pulseweaver.Studio';
    extends: 'com.pulseweaver.Theme';
    author: 'Pulse Weaver';
    dark: 'true';
}
@OBSThemeVars {
    --primary: #705AB5;
    --primary_light: #9B82DB;
    --primary_lighter: #CCBAF4;
    --primary_dark: #514174;
    --pw_accent: #BAA2EC;
    --pw_selection: #2B263D;
}

/* The 2.0 workspaces share raised controls and recessed production surfaces.
 * Appearance changes selected caps and focus cues without changing geometry. */